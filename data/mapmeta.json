    "cpe-server-1-0": {
      "badge": "proven",
      "vendor": "ZTE",
      "role": "CPE CR",
      "findings": [
        "CPE-SERVER and cpe@zte.com markers were found in the inspected ZTE H108N image; they can describe related endpoints.",
        "Operator and port associations support research slices, not hardware-model attribution.",
        "Two inspected ZTE F670L firmware generations contain the cpe@zte.com realm and a default connection-request port of 58000. Operator NAT can hide such listeners from public indexing."
      ],
      "anomalies": [
        "A second line at Three UK: unusual outside Italy and Asia"
      ],
